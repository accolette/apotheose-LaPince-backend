@startuml

actor Utilisateur

participant "React Frontend" as Front
participant "Express API" as API
database "PostgreSQL" as DB

Utilisateur -> Front : Remplit le formulaire projet\n(nom, type, budget optionnel, participants optionnels)
activate Front

Front -> API : POST /api/projects\n{ name, type, description?,\n  budget?: { amount, alertEnabled, limitCriteria },\n  participants?: [{ name, isMe? }] }
activate API

alt Token JWT absent ou invalide
    API --> Front : 401 Non authentifié
    Front --> Utilisateur : Redirigé vers /login
else Utilisateur authentifié

    API -> API : Zod parse() — validation du body

    alt Données invalides
        API --> Front : 400 Données invalides
        Front --> Utilisateur : Erreurs affichées dans le formulaire
    else Données valides

        API -> DB : BEGIN TRANSACTION
        activate DB

        API -> DB : INSERT project (name, type, description, appUserId)
        DB --> API : project.id

        alt Budget fourni
            API -> DB : INSERT budget (amount, limitCriteria, projectId)\nnote: si alertEnabled=false → limitCriteria=100
            DB --> API : budget créé
        end

        alt Participants fournis
            loop Pour chaque participant
                API -> DB : INSERT participant (name, appUserId si isMe=true)
                DB --> API : participant.id
                API -> DB : INSERT project_participant (projectId, participantId)
            end
        end

        API -> DB : SELECT project (avec budget + participants)
        DB --> API : projet complet
        
        API -> DB : COMMIT
        deactivate DB

        API --> Front : 201 Projet créé (objet complet)
        deactivate API

        Front -> Front : Invalide le cache TanStack Query (projets)
        Front --> Utilisateur : Redirigé vers /project/:id
        deactivate Front

    end

end

@enduml
