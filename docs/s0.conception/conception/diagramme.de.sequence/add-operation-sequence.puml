@startuml

actor Utilisateur

participant "React Frontend" as Front
participant "Express API" as API
database "PostgreSQL" as DB

Utilisateur -> Front : Saisit une dépense (nom, montant, date, catégorie, payeur, participants)
activate Front

Front -> Front : Calcule les parts (auto : parts égales / manuel : montants saisis)
Front -> Front : Valide la cohérence (somme parts == montant total)

Front -> API : POST /api/projects/:id/operations\n{ name, amount, date, categoryId, payerParticipantId,\n  isAmountCalculated, projectId,\n  operationParticipants: [{ participantId, repartitionAmount, isRepartitionAmountCalculated }] }
activate API

API -> API : Zod parse() — validation du body
API -> DB : assertProjectOwner(projectId, userId)
activate DB
DB --> API : OK / 403 Forbidden
deactivate DB

alt Accès refusé
    API --> Front : 403 Forbidden
    Front --> Utilisateur : Accès refusé
else Accès autorisé

    API -> DB : BEGIN TRANSACTION
    activate DB

    API -> DB : INSERT operation
    DB --> API : operation.id

    API -> DB : INSERT operation_participant (x N participants)
    DB --> API : OK

    API -> DB : budget.findUnique(projectId) — vérifier seuil d'alerte
    DB --> API : budget | null

    alt Budget défini ET seuil dépassé ET aucune alerte active
        API -> DB : INSERT alert + INSERT app_user_alert
        DB --> API : alerte créée
    end

    API -> DB : COMMIT
    DB --> API : transaction OK
    deactivate DB

    API --> Front : 201 Opération créée
    deactivate API

    Front -> Front : Invalide le cache TanStack Query\n(opérations, budgets, balance)
    Front --> Utilisateur : Dépense affichée — budgets et soldes mis à jour
    deactivate Front

end

@enduml
